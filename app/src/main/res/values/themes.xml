<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme forced to Light Mode for consistent ARMS styling -->
    <style name="Base.Theme.ACCIDENTREPORTANDMONITORINGSYSTEM" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/arms_navy</item>
        <item name="colorSecondary">@color/arms_red</item>
        <item name="android:windowBackground">@color/arms_background</item>
    </style>

    <style name="Theme.ACCIDENTREPORTANDMONITORINGSYSTEM" parent="Base.Theme.ACCIDENTREPORTANDMONITORINGSYSTEM" />

    <!-- Custom ARMS Button Styles with Smooth Press/Ripple Transitions -->
    <style name="Widget.ARMS.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/arms_white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.ARMS.Button.Emergency" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_emergency_button</item>
        <item name="android:textColor">@color/arms_white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.ARMS.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:textColor">@color/arms_navy</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
