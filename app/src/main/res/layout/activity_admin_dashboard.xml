<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true">

    <!-- Fragment Container -->
    <FrameLayout
        android:id="@+id/adminFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavContainer"
        android:background="#F8FAFC" />

    <!-- Bottom Navigation Bar Container (Side-to-Side Rectangular Gradient Bar) -->
    <RelativeLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:background="@android:color/transparent"
        android:elevation="16dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/adminBottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_citizen_nav_gradient"
            app:itemIconTint="@color/arms_white"
            app:itemTextColor="@color/arms_white"
            app:menu="@menu/menu_admin_bottom"
            app:elevation="12dp" />

    </RelativeLayout>
</RelativeLayout>
