<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardIncidentRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/arms_card_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/arms_divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Collapsed Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvIncidentTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Structure Fire Incident"
                android:textColor="@color/arms_navy"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResponderStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFEBEE"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="En Route"
                android:textColor="#DC2626"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvIncidentLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Valencia City • Incident #ARMS-FIRE-001"
            android:textColor="@color/arms_secondary_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvAssignedResponders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#E3F2FD"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Assigned Units: BFP"
            android:textColor="#2563EB"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Expandable Content Container (Small/Hidden by default) -->
        <LinearLayout
            android:id="@+id/layoutExpandableDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:background="@color/arms_divider" />

            <TextView
                android:id="@+id/tvIncidentDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Details: Emergency dispatch assigned to your unit."
                android:textColor="@color/arms_secondary_text"
                android:textSize="12sp" />

            <!-- Evidence Photo Preview -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/arms_navy"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivResponderEvidencePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvNoPhotoHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="No photographic evidence attached"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAcceptDispatch"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="Accept"
                    android:textColor="#2563EB"
                    android:textSize="11sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="#2563EB" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnRoute"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:text="En Route"
                    android:textColor="#D97706"
                    android:textSize="11sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="#D97706" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOnScene"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="On Scene"
                    android:textColor="#DC2626"
                    android:textSize="11sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="#DC2626" />
            </LinearLayout>

            <!-- Action Buttons Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNavigateMap"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="🗺️ Navigate Map"
                    android:textColor="#2563EB"
                    android:textSize="11sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="#2563EB" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayVideoEvidence"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:text="🎥 Play Video"
                    android:textColor="#7C3AED"
                    android:textSize="11sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="#7C3AED"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResolve"
                    style="@style/Widget.ARMS.Button.Emergency"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="✅ Resolve"
                    android:textSize="11sp"
                    app:cornerRadius="10dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
