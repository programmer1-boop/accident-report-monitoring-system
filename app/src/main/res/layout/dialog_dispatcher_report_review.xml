<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/arms_card_bg"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvReviewRefTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 Incident Review #ARMS-VAL"
                android:textColor="@color/arms_navy"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseReview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="✕"
                android:textColor="@color/arms_navy"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Evidence Media Preview Card (Photo or Video indicator) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardBackgroundColor="@color/arms_navy"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivReviewEvidence"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerCrop" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReviewPlayVideo"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_centerInParent="true"
                    android:text="▶ Play Video Evidence"
                    android:textColor="@color/arms_white"
                    android:textSize="12sp"
                    app:backgroundTint="#80000000"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/arms_white"
                    android:visibility="gone" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Incident Details -->
        <TextView
            android:id="@+id/tvReviewType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Road Accident / Collision"
            android:textColor="@color/arms_navy"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvReviewLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📍 Purok 3, Valencia City"
            android:textColor="@color/arms_secondary_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvReviewTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="🕒 Reported 2 mins ago"
            android:textColor="@color/arms_secondary_text"
            android:textSize="12sp" />

        <!-- Action Buttons (Dispatch Team & View on Map) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReviewMap"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="🗺️ View on Map"
                android:textColor="#2563EB"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:strokeColor="#2563EB" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReviewDispatch"
                style="@style/Widget.ARMS.Button.Emergency"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="🚀 Dispatch Team"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
