<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_arms_navy_gradient"
    android:fillViewport="true">

    <!-- Abstract Glassmorphism Background Blobs -->
    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp"
        android:background="@drawable/bg_glass_blob" />

    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="-60dp"
        android:layout_marginBottom="-60dp"
        android:background="@drawable/bg_glass_blob" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingVertical="48dp">

            <!-- Official ARMS Emblem Logo & Text PNG -->
            <ImageView
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:layout_marginBottom="4dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/arms_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="36dp"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:text="REPORT. MONITOR. RESPOND."
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Offline Pending Sync Banner (Shown when offline reports await upload) -->
            <TextView
                android:id="@+id/tvWelcomePendingSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="#FEF3C7"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="Pending offline reports awaiting sync (Tap to retry)"
                android:textColor="#92400E"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Hold 3s Instant SOS Panic Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWelcomeSosHold"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#991B1B"
                android:text="HOLD 3s FOR INSTANT SOS"
                android:textColor="@color/arms_white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:elevation="4dp" />

            <!-- Emergency Guest Report Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinueGuest"
                style="@style/Widget.ARMS.Button.Emergency"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:text="🚨 EMERGENCY REPORT AS GUEST"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:elevation="4dp" />

            <!-- Track Guest Report Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrackGuestReport"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"
                android:text="Track Guest Report"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:strokeColor="#38BDF8"
                app:strokeWidth="1.2dp" />

            <!-- Sign In Button (Glass / White Style) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignIn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:text="Sign In"
                android:textColor="@color/arms_white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="1.5dp" />

            <!-- Sign Up Link -->
            <TextView
                android:id="@+id/tvSignUpLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:text="New Citizen? Register Account"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
