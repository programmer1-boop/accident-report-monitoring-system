<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arms_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="40dp">

        <!-- Top Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <ImageButton
                android:id="@+id/ibBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/arms_navy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Review &amp; Dispatch Incident"
                android:textColor="@color/arms_navy"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Evidence Preview -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/arms_navy"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <ImageView
                android:id="@+id/ivDispatchEvidence"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Incident Evidence"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Incident Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/arms_card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/arms_divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvDispatchIncidentType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ROAD ACCIDENT"
                    android:textColor="@color/arms_navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDispatchIncidentRef"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ref: #ARMS-2026-VAL0000"
                    android:textColor="@color/arms_secondary_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDispatchLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Sayre Highway, Valencia City (7.9064, 125.0942)"
                    android:textColor="@color/arms_navy"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvDispatchDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Reporter notes..."
                    android:textColor="@color/arms_secondary_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Assign Responder Teams -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/arms_card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/arms_divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assign Responder Teams"
                    android:textColor="@color/arms_navy"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbAssignCdrrmo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Valencia City CDRRMO" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbAssignBfp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bureau of Fire Protection (BFP)" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbAssignPnp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Philippine National Police (PNP)" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbAssignMedical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Valencia City Medical / EMS" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerifyAndDispatch"
                    style="@style/Widget.ARMS.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:text="Verify &amp; Dispatch Selected Teams" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reject Report Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/arms_card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/arms_divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reject Invalid Report"
                    android:textColor="@color/arms_red"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Rejection Reason (Required)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRejectReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRejectIncident"
                    style="@style/Widget.ARMS.Button.Emergency"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:text="Reject Report" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
