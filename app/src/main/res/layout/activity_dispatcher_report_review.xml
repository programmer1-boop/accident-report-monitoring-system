<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="64dp">

        <!-- Modern Top Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="4dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:cardBackgroundColor="@color/arms_card_bg"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <ImageButton
                    android:id="@+id/ibBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/arms_navy" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Incident Review Center"
                android:textColor="@color/arms_navy"
                android:textSize="17sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Modern Immersive Evidence Media Preview Card (400dp Height, fitCenter for Universal Compatibility) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="#0F172A"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivReviewEvidence"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter" />

                <!-- Gradient Overlay for Contrast -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_alignBottom="@id/ivReviewEvidence"
                    android:background="@drawable/bg_gradient_dark_fade" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReviewPlayVideo"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_centerInParent="true"
                    android:text="▶ Play Video Evidence"
                    android:textColor="@color/arms_white"
                    android:textSize="12sp"
                    app:backgroundTint="#80000000"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/arms_white"
                    android:visibility="gone" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Modern Incident Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/arms_card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvReviewRefTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#FFEBEE"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="🚨 INCIDENT REVIEW #ARMS-VAL"
                    android:textColor="#DC2626"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReviewType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Road Accident / Collision"
                    android:textColor="@color/arms_navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReviewLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="📍 Purok 3, Valencia City"
                    android:textColor="@color/arms_secondary_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvReviewTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="🕒 Reported 2 mins ago"
                    android:textColor="@color/arms_secondary_text"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Modern Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReviewMap"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="🗺️ View on Map"
                android:textColor="#2563EB"
                android:textSize="13sp"
                app:cornerRadius="14dp"
                app:strokeColor="#2563EB"
                app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReviewDispatch"
                style="@style/Widget.ARMS.Button.Emergency"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="🚀 Dispatch Team"
                android:textSize="13sp"
                app:cornerRadius="14dp"
                app:elevation="3dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
