<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Sweep Gradient Layer -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="sweep"
                android:startColor="#142B4A"
                android:centerColor="#203F65"
                android:endColor="#315F91" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Inner Background Layer to create border effect -->
    <item android:left="2.5dp" android:top="2.5dp" android:right="2.5dp" android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/arms_card_bg" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
