# ARMS Backend Environment Configuration Template
# Copy this file to .env and configure local PostgreSQL credentials and JWT secrets.

PORT=5000
NODE_ENV=development

# PostgreSQL Connection Settings
PGHOST=localhost
PGPORT=5432
PGDATABASE=arms_db
PGUSER=postgres
PGPASSWORD=your_postgres_password_here

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
